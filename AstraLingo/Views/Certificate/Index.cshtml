@model AstraLingo.Models.User

<style>

    body {
        background: linear-gradient( 135deg, #f6d365, #fda085);
        color: white;
    }


    .certificate {
        background: white;
        color: black;
        border-radius: 25px;
        padding: 60px;
        text-align: center;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }

</style>


<div class="container py-5">

    <div class="certificate">

        <h1 style="
            font-size:60px;
            color:#ff9800;">

            🎓 Certificate

        </h1>


        <br />


        <h2>

            This Certificate is Proudly Presented To

        </h2>


        <h1 class="mt-4"
            style="
            font-size:55px;
            color:#673ab7;">

            @Model.Name

        </h1>


        <br />


        <h3>

            For Successfully Completing
            AstraLingo Learning Journey

        </h3>


        <br /><br />


        <h2>

            🏆 Level:
            @Model.Level

        </h2>


        <h2 class="mt-3">

            ⭐ XP:
            @Model.XP

        </h2>


        <br /><br />


        <button onclick="window.print()"
                class="
                btn btn-warning
                btn-lg">

            Download Certificate 📥

        </button>

    </div>

</div>