@model List<AstraLingo.Models.Lesson>

@{
    ViewData["Title"] = "Lessons";
}

<style>

    body {
        background: linear-gradient( 135deg, #667eea, #764ba2);
        min-height: 100vh;
    }


    .lesson-title {
        color: white;
        font-size: 50px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 50px;
        text-shadow: 2px 2px 10px rgba(0,0,0,0.3);
    }


    .lesson-card {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border-radius: 30px;
        padding: 35px;
        color: white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        transition: 0.4s;
        height: 100%;
    }


        .lesson-card:hover {
            transform: translateY(-10px) scale(1.02);
            background: rgba(255,255,255,0.22);
        }


    .lesson-icon {
        font-size: 60px;
        margin-bottom: 20px;
    }


    .lesson-btn {
        border-radius: 15px;
        font-weight: bold;
        padding: 12px;
        transition: 0.3s;
    }


        .lesson-btn:hover {
            transform: scale(1.05);
        }


    .top-btn {
        border-radius: 15px;
        padding: 12px 30px;
        font-weight: bold;
    }

</style>



<div class="container py-5">


    <!-- PAGE TITLE -->

    <h1 class="lesson-title">

        📚 AstraLingo Lessons

    </h1>



    <!-- LESSONS -->

    <div class="row">


        @foreach (var lesson in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">

                <div class="lesson-card text-center">


                    <!-- ICON -->

                    <div class="lesson-icon">

                        📖

                    </div>


                    <!-- TITLE -->

                    <h2 class="fw-bold">

                        @lesson.Title

                    </h2>


                    <hr class="text-light" />


                    <!-- CONTENT -->

                    <p style="
                           font-size:18px;
                           line-height:1.8;">

                        @lesson.Content

                    </p>


                    <!-- BUTTONS -->

                    <div class="mt-4">


                        <a asp-controller="Quiz"
                           asp-action="Index"
                           asp-route-id="@lesson.LanguageId"
                           class="btn btn-warning w-100 lesson-btn">

                            🎯 Start Quiz

                        </a>


                    </div>

                </div>

            </div>
        }

    </div>



    <!-- BOTTOM BUTTONS -->

    <div class="text-center mt-5">


        <a asp-controller="Language"
           asp-action="Index"
           class="btn btn-light top-btn">

            🌍 Back To Languages

        </a>


        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-dark top-btn ms-3">

            🚀 Dashboard

        </a>

    </div>

</div>