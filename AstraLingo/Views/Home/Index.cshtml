@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid p-0">

    <!-- HERO SECTION -->
    <div class="text-center text-white p-5"
         style="
         background: linear-gradient(
         to right,
         #4facfe,
         #00f2fe);
         min-height: 500px;">

        <br /><br />

        <h1 style="
            font-size:70px;
            font-weight:bold;">

            🌍 AstraLingo

        </h1>


        <h3 class="mt-4">

            Learn Languages with
            Games, Missions & Rewards

        </h3>


        <p class="mt-3"
           style="font-size:20px;">

            Practice speaking,
            complete missions,
            earn XP,
            unlock achievements,
            and become a language master.

        </p>


        <br />


        <a href="/Account/Register"
           class="btn btn-warning btn-lg m-2 px-5">

            🚀 Get Started

        </a>


        <a href="/Account/Login"
           class="btn btn-light btn-lg m-2 px-5">

            Login

        </a>

    </div>


    <!-- FEATURES -->
    <div class="container mt-5">

        <h2 class="text-center mb-5">

            ✨ Features

        </h2>


        <div class="row">


            <div class="col-md-4">

                <div class="card shadow-lg p-4 text-center border-0">

                    <h1>

                        📚

                    </h1>

                    <h3>

                        Interactive Lessons

                    </h3>

                    <p>

                        Learn English,
                        Japanese,
                        and programming
                        through fun lessons.

                    </p>

                </div>

            </div>



            <div class="col-md-4">

                <div class="card shadow-lg p-4 text-center border-0">

                    <h1>

                        🎯

                    </h1>

                    <h3>

                        XP & Levels

                    </h3>

                    <p>

                        Earn XP,
                        level up,
                        and unlock
                        advanced content.

                    </p>

                </div>

            </div>



            <div class="col-md-4">

                <div class="card shadow-lg p-4 text-center border-0">

                    <h1>

                        🏆

                    </h1>

                    <h3>

                        Achievements

                    </h3>

                    <p>

                        Collect badges,
                        certificates,
                        and leaderboard ranks.

                    </p>

                </div>

            </div>

        </div>


        <br /><br />


        <div class="row">


            <div class="col-md-4">

                <div class="card shadow-lg p-4 text-center border-0">

                    <h1>

                        🌍

                    </h1>

                    <h3>

                        Real-life Missions

                    </h3>

                    <p>

                        Complete practical tasks
                        like introducing yourself
                        or building projects.

                    </p>

                </div>

            </div>



            <div class="col-md-4">

                <div class="card shadow-lg p-4 text-center border-0">

                    <h1>

                        🎡

                    </h1>

                    <h3>

                        Daily Rewards

                    </h3>

                    <p>

                        Spin the wheel daily
                        to earn XP,
                        streaks,
                        and mystery rewards.

                    </p>

                </div>

            </div>



            <div class="col-md-4">

                <div class="card shadow-lg p-4 text-center border-0">

                    <h1>

                        🎙️

                    </h1>

                    <h3>

                        Voice Practice

                    </h3>

                    <p>

                        Practice speaking
                        with built-in
                        voice recognition.

                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- FOOTER -->
    <div class="text-center text-white p-4 mt-5"
         style="
         background:#111;">

        <h4>

            🚀 AstraLingo

        </h4>

        <p>

            Learn • Play • Level Up

        </p>

    </div>

</div>