@model AstraLingo.Models.User

@{
    ViewData["Title"] = "Dashboard";

    int progress =
        (Model.XP % 50) * 100 / 50;
}

<style>

    body {
        background: linear-gradient( 135deg, #667eea, #764ba2);
        min-height: 100vh;
    }


    .glass-card {
        background: rgba(255,255,255,0.15);
        border-radius: 25px;
        backdrop-filter: blur(10px);
        box-shadow: 0 8px 32px rgba(0,0,0,0.2);
        color: white;
    }


    .stat-card {
        transition: 0.3s;
    }


        .stat-card:hover {
            transform: translateY(-8px);
        }


    .main-btn {
        border-radius: 15px;
        padding: 15px 25px;
        font-weight: bold;
        transition: 0.3s;
    }


        .main-btn:hover {
            transform: scale(1.05);
        }

</style>


<div class="container py-5">


    <!-- TOP PROFILE -->
    <div class="glass-card p-5 text-center">

        <img src="~/images/@Model.ProfileImage"
             style="
             width:120px;
             height:120px;
             border-radius:50%;
             object-fit:cover;
             border:4px solid white;" />


        <h1 class="mt-3">

            🚀 Welcome @Model.Name

        </h1>


        @if (TempData["Reward"] != null)
        {
            <h4 class="mt-3 text-warning">

                @TempData["Reward"]

            </h4>
        }


        <h3 class="mt-3">

            @ViewBag.Badge

        </h3>

    </div>


    <br />


    <!-- STATS -->
    <div class="row text-center">


        <div class="col-md-4">

            <div class="glass-card p-4 stat-card">

                <h2>

                    ⭐ XP

                </h2>

                <h1>

                    @Model.XP

                </h1>

            </div>

        </div>



        <div class="col-md-4">

            <div class="glass-card p-4 stat-card">

                <h2>

                    🎯 Level

                </h2>

                <h1>

                    @Model.Level

                </h1>

            </div>

        </div>



        <div class="col-md-4">

            <div class="glass-card p-4 stat-card">

                <h2>

                    🔥 Streak

                </h2>

                <h1>

                    @Model.Streak Days

                </h1>

            </div>

        </div>

    </div>


    <br />


    <!-- PROGRESS -->
    <div class="glass-card p-4">

        <h3>

            📈 Progress to Next Level

        </h3>


        <div class="progress mt-4"
             style="
             height:35px;
             border-radius:20px;">

            <div class="
                 progress-bar
                 progress-bar-striped
                 progress-bar-animated
                 bg-success"
                 style="
                 width:@progress%;
                 font-size:18px;">

                @progress%

            </div>

        </div>

    </div>


    <br />


    <!-- BUTTONS -->
    <div class="row text-center">


        <div class="col-md-3 mt-3">

            <a href="/Language"
               class="
               btn btn-success
               w-100
               main-btn">

                📚 Learn

            </a>

        </div>



        <div class="col-md-3 mt-3">

            <a href="/Achievement"
               class="
               btn btn-warning
               w-100
               main-btn">

                🏆 Achievements

            </a>

        </div>



        <div class="col-md-3 mt-3">

            <a href="/Leaderboard"
               class="
               btn btn-danger
               w-100
               main-btn">

                🥇 Leaderboard

            </a>

        </div>



        <div class="col-md-3 mt-3">

            <a href="/Certificate"
               class="
               btn btn-info
               w-100
               main-btn">

                🎓 Certificate

            </a>

        </div>



        <div class="col-md-3 mt-3">

            <a href="/Mission"
               class="
               btn btn-primary
               w-100
               main-btn">

                🌍 Missions

            </a>

        </div>



        <div class="col-md-3 mt-3">

            <a href="/Voice"
               class="
               btn btn-dark
               w-100
               main-btn">

                🎙️ Voice Practice

            </a>

        </div>



        <div class="col-md-3 mt-3">

            <a href="/Reward/Spin"
               class="
               btn btn-light
               w-100
               main-btn">

                🎡 Daily Spin

            </a>

        </div>



        <div class="col-md-3 mt-3">

            <a href="/Profile"
               class="
               btn btn-secondary
               w-100
               main-btn">

                👤 Profile

            </a>

        </div>

    </div>


    <br />


    <!-- LOGOUT -->
    <div class="text-center">

        <a href="/Account/Logout"
           class="
           btn btn-outline-light
           btn-lg px-5">

            Logout

        </a>

    </div>

</div>