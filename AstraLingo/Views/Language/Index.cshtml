@model List<AstraLingo.Models.Language>

@{
    int userLevel =
        ViewBag.UserLevel;
}

<style>

    body {
        background: linear-gradient( 135deg, #667eea, #764ba2);
        color: white;
    }


    .language-card {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border-radius: 25px;
        padding: 30px;
        height: 100%;
        transition: 0.3s;
        box-shadow: 0 8px 32px rgba(0,0,0,0.2);
    }


        .language-card:hover {
            transform: translateY(-10px) scale(1.02);
        }


    .locked {
        opacity: 0.5;
    }


    .start-btn {
        border-radius: 15px;
        font-weight: bold;
        padding: 12px 25px;
        transition: 0.3s;
    }


        .start-btn:hover {
            transform: scale(1.05);
        }

</style>



<div class="container py-5">

    <h1 class="text-center mb-5">

        🌍 Choose Your Language Journey

    </h1>


    <div class="row">

        @foreach (var item in Model)
        {
            bool unlocked =
            userLevel >= item.RequiredLevel;


            <div class="col-md-6 col-lg-4 mt-4">

                <div class="
                         language-card
                         @(unlocked ? "" : "locked")">

                    <h2>

                        📚 @item.Name

                    </h2>


                    <p class="mt-3">

                        @item.Description

                    </p>


                    <h5 class="mt-4 text-warning">

                        Required Level:
                        @item.RequiredLevel

                    </h5>


                    <br />


                    @if (unlocked)
                    {
                        <a href="/Lesson/Index/@item.LanguageId"
                           class="
                                   btn btn-success
                                   start-btn">

                            Start Learning 🚀

                        </a>
                    }
                    else
                    {
                        <button class="
                                        btn btn-secondary
                                        start-btn"
                                disabled>

                            🔒 Locked

                        </button>
                    }

                </div>

            </div>
        }

    </div>

</div>