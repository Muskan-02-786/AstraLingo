@model AstraLingo.Models.Language

@{
    ViewData["Title"] = "Delete Language";
}

<style>

    body {
        background: linear-gradient( 135deg, #141e30, #243b55);
        color: white;
    }

    .delete-box {
        max-width: 600px;
        margin: auto;
        margin-top: 80px;
        background: rgba(255,255,255,0.12);
        backdrop-filter: blur(10px);
        padding: 40px;
        border-radius: 25px;
        text-align: center;
    }

</style>

<div class="delete-box">

    <h1 class="mb-4">

        🗑 Delete Language

    </h1>

    <h3>

        Are you sure you want to delete:

    </h3>

    <h2 class="text-warning mt-4">

        @Model.Name

    </h2>

    <p class="mt-3">

        @Model.Description

    </p>

    <br />

    <form asp-action="DeleteConfirmed"
          method="post">

        <input type="hidden"
               asp-for="LanguageId" />

        <button type="submit"
                class="btn btn-danger btn-lg">

            Yes Delete

        </button>

        <a asp-action="ManageLanguage"
           class="btn btn-secondary btn-lg ms-3">

            Cancel

        </a>

    </form>

</div>