@model List<AstraLingo.Models.Quiz>

<style>

    body {
        background: linear-gradient( 135deg, #667eea, #764ba2);
        color: white;
    }


    .quiz-card {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border-radius: 25px;
        padding: 30px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.2);
        transition: 0.3s;
    }


        .quiz-card:hover {
            transform: translateY(-8px);
        }


    .option {
        background: rgba(255,255,255,0.1);
        padding: 15px;
        border-radius: 15px;
        margin-top: 15px;
        cursor: pointer;
        transition: 0.3s;
        font-size: 18px;
    }


        .option:hover {
            background: rgba(255,255,255,0.25);
            transform: scale(1.02);
        }


    .submit-btn {
        border-radius: 15px;
        padding: 15px 40px;
        font-size: 22px;
        font-weight: bold;
        transition: 0.3s;
    }


        .submit-btn:hover {
            transform: scale(1.05);
        }

</style>



<div class="container py-5">

    <h1 class="text-center mb-5">

        🎯 Interactive Quiz

    </h1>


    @foreach (var quiz in Model)
    {
        <div class="quiz-card mt-5">

            <h3>

                🚀 @quiz.Question

            </h3>


            <div class="option"
                 data-correct="@(quiz.OptionA == quiz.CorrectAnswer ? "true" : "false")">

                <input type="radio"
                       name="quiz_@quiz.QuizId" />

                @quiz.OptionA

            </div>



            <div class="option"
                 data-correct="@(quiz.OptionB == quiz.CorrectAnswer ? "true" : "false")">

                <input type="radio"
                       name="quiz_@quiz.QuizId" />

                @quiz.OptionB

            </div>



            <div class="option"
                 data-correct="@(quiz.OptionC == quiz.CorrectAnswer ? "true" : "false")">

                <input type="radio"
                       name="quiz_@quiz.QuizId" />

                @quiz.OptionC

            </div>



            <div class="option"
                 data-correct="@(quiz.OptionD == quiz.CorrectAnswer ? "true" : "false")">

                <input type="radio"
                       name="quiz_@quiz.QuizId" />

                @quiz.OptionD

            </div>

        </div>
    }


    <div class="text-center mt-5">

        <button onclick="checkAnswers()"
                class="
                btn btn-success
                btn-lg
                submit-btn">

            Submit Quiz 🚀

        </button>

    </div>

</div>



<script>

    function checkAnswers()
    {
        let score = 0;

        let options =
            document.querySelectorAll(".option");


        options.forEach(function(option)
        {
            let radio =
                option.querySelector("input");


            if (radio.checked)
            {
                if (option.dataset.correct === "true")
                {
                    option.style.backgroundColor =
                        "lightgreen";

                    score++;
                }
                else
                {
                    option.style.backgroundColor =
                        "salmon";
                }
            }
        });


        setTimeout(function ()
        {
            if(score > 0)
            {
                window.location.href =
                    "/Quiz/CompleteQuiz";
            }
            else
            {
                alert(
                    "❌ No correct answers!");
            }

        }, 2000);
    }

</script>